# 복사해서 .env.local 로 만들고 값을 채운다. (.env*.local 은 git 에 올라가지 않는다)

# 카카오 개발자센터 > 앱 키 > 네이티브 앱 키
KAKAO_NATIVE_APP_KEY=

# 네이버 개발자센터 > 애플리케이션 정보
# 주의: 네이버 네이티브 SDK 구조상 Client Secret 이 앱에 포함된다.
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=
# 네이버 개발자센터 iOS 설정의 URL Scheme 과 같아야 한다.
EXPO_PUBLIC_NAVER_URL_SCHEME=

# WebView 로 띄울 웹 주소. 비우면 iOS 는 http://localhost:3000, Android 에뮬레이터는 http://10.0.2.2:3000
# 실기기에서는 Mac 의 IP 를 넣는다. 예: http://192.168.0.10:3000
EXPO_PUBLIC_WEB_URL=
