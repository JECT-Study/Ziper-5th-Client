{
  "expo": {
    "name": "Ziper",
    "slug": "ziper-mobile",
    "scheme": "ziper",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#abf61c",
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": { "supportsText": true, "supportsWebUrlWithMaxCount": 1 }
          },
          "android": { "enabled": true, "singleShareMimeTypes": ["text/*"] }
        }
      ]
    ],
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ject.ziper",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.ject.ziper",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "6ee20063-0dde-4921-b2c9-742a684df9b3"
      }
    },
    "owner": "spbabos-team"
  }
}
