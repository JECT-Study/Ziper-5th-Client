{
  "name": "ziper",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter ziper-web dev",
    "build:web": "pnpm --filter ziper-web build",
    "typecheck:web": "pnpm --filter ziper-web typecheck",
    "dev:landing": "pnpm --filter ziper-landing dev",
    "build:landing": "pnpm --filter ziper-landing build",
    "typecheck:landing": "pnpm --filter ziper-landing typecheck",
    "dev:mobile": "pnpm --filter ziper-mobile start",
    "ios:mobile": "pnpm --filter ziper-mobile ios",
    "android:mobile": "pnpm --filter ziper-mobile android",
    "typecheck:mobile": "pnpm --filter ziper-mobile typecheck",
    "test": "pnpm -r --filter '!ziper' --workspace-concurrency=1 --if-present run test",
    "typecheck:bridge": "tsc -p packages/bridge/tsconfig.json",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.32.0"
}
