-const createResolver = ({ emitter, evaluate, eventId, failHandler = false, methodName, onFallback }) => {
-	return new Promise((resolve, reject) => {
-		const unbind = emitter.on(`${methodName}-${eventId}`, (data, throwOccurred) => {
-			unbind();
-			if (throwOccurred) {
-				if (failHandler instanceof NativeMethodError) {
-					invokeCallback("onFallback", onFallback);
-					reject(deserializeError(throwOccurred));
-				} else if (failHandler instanceof Error) reject(failHandler);
-				else resolve(void 0);
-			} else resolve(data);
-		});
-		evaluate();
-	});
+const createResolver = ({ emitter, evaluate, eventId, failHandler = false, methodName, onFallback, signal }) => {
+  return new Promise((resolve, reject) => {
+    let settled = false;
+    let unbind = () => {};
+    const finish = (failed, value) => {
+      if (settled) return;
+      settled = true;
+      unbind();
+      signal?.removeEventListener("abort", onAbort);
+      if (failed) reject(value); else resolve(value);
+    };
+    const onAbort = () => finish(true, signal.reason ?? new Error("Aborted"));
+    if (signal?.aborted) { onAbort(); return; }
+    unbind = emitter.on(`${methodName}-${eventId}`, (data, throwOccurred) => {
+      if (throwOccurred) {
+        if (failHandler instanceof NativeMethodError) {
+          invokeCallback("onFallback", onFallback);
+          finish(true, deserializeError(throwOccurred));
+        } else if (failHandler instanceof Error) finish(true, failHandler);
+        else finish(false, undefined);
+      } else finish(false, data);
+    });
+    signal?.addEventListener("abort", onAbort, { once: true });
+    try { evaluate(); } catch (error) { finish(true, error); }
+  });
 };
